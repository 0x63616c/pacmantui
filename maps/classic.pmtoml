# Classic Pac-Man maze, transcribed from The Pac-Man Dossier (v1.0.27).
# Source of every value: docs/research/dossier-mechanics.md (grid §1.2, start
# positions §1.3, scatter targets §3.5, red zones §3.7, tunnel zones §2.5,
# fruit §1.3/§5.2). Format spec: docs/map-format.md (format_version 1).
#
# The full 28x36 screen grid is represented (rows 0-2 and 34-35 are the HUD
# margins, kept as wall rows) so tile coordinates match the dossier's.

format_version = 1
name = "Classic"
id = "classic"

# Grid legend: '#' wall  '.' dot  'o' energizer  ' '/'_' path (no dot)
# '-' ghost-house door  'H' house interior  'T' tunnel (ghost slowdown) tile.
# Tunnel slowdown zones per dossier §2.5: row 17 cols 0-4 and 23-27.
grid = '''
############################
############################
############################
############################
#............##............#
#.####.#####.##.#####.####.#
#o####.#####.##.#####.####o#
#.####.#####.##.#####.####.#
#..........................#
#.####.##.########.##.####.#
#.####.##.########.##.####.#
#......##....##....##......#
######.##### ## #####.######
######.##### ## #####.######
######.##          ##.######
######.## ###--### ##.######
######.## #HHHHHH# ##.######
TTTTT .   #HHHHHH#   . TTTTT
######.## #HHHHHH# ##.######
######.## ######## ##.######
######.##          ##.######
######.## ######## ##.######
######.## ######## ##.######
#............##............#
#.####.#####.##.#####.####.#
#.####.#####.##.#####.####.#
#o..##.......  .......##..o#
###.##.##.########.##.##.###
###.##.##.########.##.##.###
#......##....##....##......#
#.##########.##.##########.#
#.##########.##.##########.#
#..........................#
############################
############################
############################
'''

# Ghost red zones (dossier §3.7): the four decision tiles where ghosts may not
# turn up — (12,14) (15,14) above the house, (12,26) (15,26) on Pac-Man's row.
no_up_tiles = [[12, 14], [15, 14], [12, 26], [15, 26]]

# Spawns are pixel-precise: pixel = tile center (8x+4, 8y+4) + offset_px.
# Classic actors start centered on a tile-column boundary (dossier §1.3), so
# each uses offset_px = [4, 0]: Pac-Man (112,212), Blinky (112,116),
# Pinky (112,140), Inky (96,140), Clyde (128,140).
# Facing dirs: unstated in the dossier (§8.4) but ROM-derived in
# docs/research/arcade-supplements.md §7 (pac/blinky left, pinky down,
# inky/clyde up); positions there confirm the dossier's measurements.
[spawns]
pac = { tile = [13, 26], offset_px = [4, 0], facing = "left" }
blinky = { tile = [13, 14], offset_px = [4, 0], facing = "left" }
pinky = { tile = [13, 17], offset_px = [4, 0], facing = "down" }
inky = { tile = [11, 17], offset_px = [4, 0], facing = "up" }
clyde = { tile = [15, 17], offset_px = [4, 0], facing = "up" }

# Scatter targets (dossier §3.5, measured from Scatter.png). §8.1's one-row
# ambiguity vs secondary sources is settled: arcade-supplements.md §8 derives
# these exact values from ROM constants. This map is the one place to change
# them. Top targets are off-grid (row -1).
[scatter]
blinky = [25, -1]
pinky = [2, -1]
inky = [27, 34]
clyde = [0, 34]

# House center = Pinky's slot (revival point, dossier §1.3); eyes target is
# the tile directly above the left door tile (dossier §3.5).
[house]
center = { tile = [13, 17], offset_px = [4, 0] }
eyes_target = [13, 14]

# Fruit appears directly below the pen (dossier §1.3): boundary of tiles
# (13,20)/(14,20), pixel (112,164).
[fruit]
pos = { tile = [13, 20], offset_px = [4, 0] }
